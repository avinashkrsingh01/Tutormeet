# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TutorMeet

# (Future) Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Payment system
# PAYMENT_GATEWAY=manual         # manual (default) | razorpay | stripe
# PLATFORM_FEE_PERCENTAGE=10     # platform fee % (default 10%)
# PLATFORM_FEE_MIN_PAISE=0       # minimum fee in paise

# (Future) MSG91 / Twilio OTP
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
